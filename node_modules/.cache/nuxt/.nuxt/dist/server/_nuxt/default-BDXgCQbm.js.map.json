MAAA,MAAA,CAAM,CAAA,GAAA;qDAA9B,MAAA,UAAA,CAAU,CAAC,MAAM,OAAO,MAAA,MAAA,CAAM,CAAA,GAAA,CAAA,CAAA;;;;;;;;;6IASS,iBAAe,MAAA,YAAA,CAAY,EAAA,EAAA;6CAChE,MAAM,GAAE,GAAA,MAAA,OAAA,CAAA;iCACR,MAAA,MAAA,MAAM,OAAA,WAAA,QAAA,EAAA,QAAA;kDACD,MAAM,GAAE,GAAA,MAAA,OAAA,CAAA;;OAEb,MAAA,YAAA,GAAA,MAAA,uHAAA;;0DAM+B,MAAA,UAAA,EAAU,GAAA,YAAA,CAAA,EAAA,6CAAA,cACT,cAAY,MAAA,CAAA,CAAC,CAAA,YAAA,CAAA,EAAA,EAAA;6CAC7C,MAAM,GAAE,GAAA,MAAA,OAAA,CAAA;;OAGX,MAAA,UAAA,GAAA,MAAA,SAAA,cAAA,SACG,MAAA,WAAA,CAAW,IAAA,cACnB,eAAa,MAAA,MAAA,MAAM,OAAA,gBAAA,MAAA,EAAA,gBAAA;;OAIX,MAAA,UAAA,GAAU;;kBACM,MAAA,aAAA,IAAV,WAAM;2DACR,OAAO,cAAc,EAAA,iBAAA,eACvB,OAAO,oBAAoB,EAAA,iBAAA;;;;yEAKC,cAAY,MAAA,QAAA,IAAQ,eAAA,WAAA,IAAA,cAAgC,iBAAe,MAAA,QAAA,CAAQ,EAAA,EAAA;OAC3G,MAAA,QAAA,GAAA,MAAA,mBAAA,MAAA,CAAA,GAAA,EAAW,MAAM,GAAE,GAAA,MAAA,OAAA,CAAA;gDACd,MAAM,GAAE,GAAA,MAAA,OAAA,CAAA;;OAMf,MAAA,QAAA,GAAQ;;kBAEQ,MAAA,QAAA,IAAR,SAAI;mDACd,MAAA,UAAA,CAAU,CAAC,KAAK,OAAO,MAAA,MAAA,CAAM,CAAA,EAAA,UAAA;;;kBAGhB,MAAA,aAAA,IAAT,UAAK;;MACX,KAAK,MAAM;MACZ,OAAM;MACL,IAAI,MAAA,UAAA,CAAU,CAAC,MAAM,IAAI;;wBAGjB,GAAA,OAAA,SAAA,aAAA;0CADN,MAAA,UAAA,CAAU,CAAC,MAAM,OAAO,MAAA,MAAA,CAAM,CAAA,GAAA;oDAA9B,MAAA,UAAA,CAAU,CAAC,MAAM,OAAO,MAAA,MAAA,CAAM,CAAA,GAAA,CAAA,CAAA;;;;;;;;;;;;;;;;;;;;;;;;;;EEpK7C,MAAM,EAAE,QAAQ,MAAM,QAAQ;EAC9B,MAAM,aAAa,cAAc;;;+CAIvB,OAAM,cAAa,GAAA,MAAA,CAAA,EAAA,2DAAA;;IAGX,OAAM;IAAqB,IAAI,MAAA,UAAA,CAAU,CAAA,GAAA;;sBAExC,GAAA,OAAA,SAAA,aAAA;8DADe,OAAA,qDAAmC,IAAA,cAAE,OAAK,MAAA,CAAA,CAAC,CAAA,UAAA,CAAA,IAAA,SAAA,EAAA;kBAAnE,YAAmF,OAAA;MAA9E,OAAM;MAAa,KAAA;MAAqC,KAAK,MAAA,CAAA,CAAC,CAAA,UAAA;;;;;8BAE/D,MAAA,CAAA,CAAC,CAAA,gBAAA,CAAA,EAAA,KAAA;;IACG,OAAM;IAA6B,IAAI,MAAA,UAAA,CAAU,CAAA,kBAAA;;sBAEhD,GAAA,OAAA,SAAA,aAAA;;8BADN,MAAA,CAAA,CAAC,CAAA,aAAA,CAAA,EAAA,EAAA;sDAAkC,MAAM,GAAE,GAAA,MAAA,SAAA,QAAA,CAAA;oDAA3C,MAAA,CAAA,CAAC,CAAA,aAAA,CAAA,IAAkB,KAAC,CAAA,GAAA,YAA2B,MAAA,YAAA,GAAA,EAAZ,MAAM,GAAE,CAAA,CAAA;;;;;iBAIH,MAAA,QAAA,CAAQ,CAAC,MAAK,CAAA,IAAtB,SAAI;gEAClC,MAAA,UAAA,CAAU,CAAC,KAAK,OAAO,MAAA,MAAA,CAAM,CAAA,EAAA,wCAAA;kBAER,KAAK,WAAd,UAAK;;MAAoB,KAAK,MAAM;MAAM,IAAI,MAAA,UAAA,CAAU,CAAC,MAAM,IAAI;;wBAEzE,GAAA,OAAA,SAAA,aAAA;0CADN,MAAA,UAAA,CAAU,CAAC,MAAM,OAAO,MAAA,MAAA,CAAM,CAAA,GAAA;oDAA9B,MAAA,UAAA,CAAU,CAAC,MAAM,OAAO,MAAA,MAAA,CAAM,CAAA,GAAA,CAAA,CAAA;;;;;;;kEAM9B,MAAA,CAAA,CAAC,CAAA,eAAA,CAAA,EAAA,0BAAA;wDAEc,MAAM,GAAE,GAAA,MAAA,OAAA,CAAA;iCACnB,MAAA,MAAA,MAAM,OAAA,4BAAA,UAAA,EAAA,gDAAA;+CAE4B,MAAM,GAAE,GAAA,MAAA,OAAA,CAAA;kGAIvC,MAAA,CAAA,CAAC,CAAA,UAAA,CAAA,EAAA,GAAA,eAAmB,MAAA,CAAA,CAAC,CAAA,eAAA,CAAA,EAAA,KAAA,eAA0B,MAAA,CAAA,CAAC,CAAA,eAAA,CAAA,EAAA,eAAA,eACvD,MAAA,CAAA,CAAC,CAAA,gBAAA,CAAA,EAAA,KAAA,eAA2B,MAAA,CAAA,CAAC,CAAA,cAAA,CAAA,EAAA,uBAAA;;;;;;;;;;;;;;;;;;;0CEzC7B,OAAM,aAAY,GAAA,MAAA,CAAA,EAAA,EAAA","names":[],"sources":["../../../../../../../app/components/SiteHeader.vue","../../../../../../../app/components/SiteHeader.vue","../../../../../../../app/components/SiteFooter.vue","../../../../../../../app/components/SiteFooter.vue","../../../../../../../app/layouts/default.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport { ChevronDown, Globe2, Menu, Search, X } from 'lucide-vue-next'\nimport { getNavByPath, localeText, navItems, searchIndex } from '~/data/site'\n\nconst { locale, setLocale, t } = useI18n()\nconst localePath = useLocalePath()\nconst route = useRoute()\n\nconst menuOpen = ref(false)\nconst languageOpen = ref(false)\nconst searchOpen = ref(false)\nconst searchQuery = ref('')\nconst hoveredNavKey = ref<string | null>(null)\n\nconst activeState = computed(() => getNavByPath(route.path))\nconst currentNav = computed(() => navItems.find((item) => item.key === hoveredNavKey.value) ?? null)\nconst showSubNav = computed(() => !!currentNav.value?.children?.length && currentNav.value.key !== 'home')\nconst subNavChildren = computed(() => currentNav.value?.children ?? [])\nconst routeChildren = computed(() => activeState.value.activeNav.children ?? [])\nconst localizedSearchIndex = computed(() => searchIndex.map((item) => ({\n  ...item,\n  localizedLabel: localeText(item.label, locale.value),\n  localizedDescription: localeText(item.description, locale.value)\n})))\nconst searchResults = computed(() => {\n  const query = searchQuery.value.trim().toLowerCase()\n  if (!query) return localizedSearchIndex.value.slice(0, 6)\n  return localizedSearchIndex.value\n    .filter((item) => `${item.localizedLabel} ${item.localizedDescription}`.toLowerCase().includes(query))\n    .slice(0, 6)\n})\n\nfunction closeFloating() {\n  menuOpen.value = false\n  languageOpen.value = false\n  searchOpen.value = false\n  hoveredNavKey.value = null\n}\n\nfunction openSubNav(key: string) {\n  hoveredNavKey.value = key\n}\n\nfunction clearSubNav() {\n  hoveredNavKey.value = null\n}\n\nfunction goMain(item: typeof navItems[number]) {\n  closeFloating()\n  return navigateTo(localePath(item.key === 'home' ? '/' : item.path))\n}\n\nfunction goSearch(path: string) {\n  searchQuery.value = ''\n  closeFloating()\n  return navigateTo(localePath(path))\n}\n\nasync function changeLanguage(nextLocale: 'zh' | 'en') {\n  localStorage.setItem('site-locale', nextLocale)\n  languageOpen.value = false\n  await setLocale(nextLocale)\n}\n\nwatch(() => route.fullPath, () => closeFloating())\n\nonMounted(async () => {\n  const stored = localStorage.getItem('site-locale')\n  if ((stored === 'zh' || stored === 'en') && stored !== locale.value) {\n    await setLocale(stored)\n  }\n})\n</script>\n\n<template>\n  <a class=\"skip-link\" href=\"#main\">{{ locale === 'en' ? 'Skip to content' : '跳到正文' }}</a>\n  <header class=\"site-header\" @mouseleave=\"clearSubNav\">\n    <div class=\"shell header-inner\">\n      <NuxtLink class=\"brand\" :to=\"localePath('/')\" :aria-label=\"t('siteName')\">\n        <img class=\"brand-logo\" src=\"/assets/company-logo-wide.png\" :alt=\"t('siteName')\" />\n      </NuxtLink>\n\n      <nav class=\"desktop-nav\" :aria-label=\"locale === 'en' ? 'Primary navigation' : '主导航'\">\n        <div\n          v-for=\"item in navItems\"\n          :key=\"item.key\"\n          class=\"nav-item-group\"\n          @mouseenter=\"openSubNav(item.key)\"\n        >\n          <button\n            type=\"button\"\n            class=\"nav-link\"\n            :class=\"{ active: activeState.activeNav.key === item.key }\"\n            :aria-expanded=\"showSubNav && currentNav?.key === item.key ? 'true' : 'false'\"\n            @focus=\"openSubNav(item.key)\"\n            @click=\"goMain(item)\"\n          >\n            {{ localeText(item.label, locale) }}\n          </button>\n\n          <Transition name=\"subnav\">\n            <div v-if=\"showSubNav && currentNav?.key === item.key\" class=\"subnav\">\n              <NuxtLink\n                v-for=\"child in subNavChildren\"\n                :key=\"child.key\"\n                class=\"subnav-pill\"\n                :class=\"{ active: activeState.activeChild?.key === child.key }\"\n                :to=\"localePath(child.path)\"\n                @click=\"clearSubNav\"\n              >\n                {{ localeText(child.label, locale) }}\n              </NuxtLink>\n            </div>\n          </Transition>\n        </div>\n      </nav>\n\n      <div class=\"header-actions\">\n        <div class=\"language-menu\">\n          <button class=\"icon-text-button\" type=\"button\" :aria-expanded=\"languageOpen\" @click=\"languageOpen = !languageOpen\">\n            <Globe2 :size=\"17\" />\n            <span>{{ locale === 'zh' ? '中 / EN' : 'EN / 中' }}</span>\n            <ChevronDown :size=\"15\" />\n          </button>\n          <div v-if=\"languageOpen\" class=\"popover language-popover\">\n            <button type=\"button\" @click=\"changeLanguage('zh')\">中文简体</button>\n            <button type=\"button\" @click=\"changeLanguage('en')\">English</button>\n          </div>\n        </div>\n\n        <div class=\"search-box\" :class=\"{ expanded: searchOpen }\">\n          <button class=\"icon-button\" type=\"button\" :aria-label=\"t('cta.search')\" @click=\"searchOpen = !searchOpen\">\n            <Search :size=\"18\" />\n          </button>\n          <input\n            v-if=\"searchOpen\"\n            v-model=\"searchQuery\"\n            :placeholder=\"locale === 'en' ? 'Search site' : '站内搜索'\"\n            type=\"search\"\n            @keydown.esc=\"searchOpen = false\"\n          />\n          <div v-if=\"searchOpen\" class=\"popover search-popover\">\n            <button v-for=\"result in searchResults\" :key=\"result.path\" type=\"button\" @click=\"goSearch(result.path)\">\n              <strong>{{ result.localizedLabel }}</strong>\n              <span>{{ result.localizedDescription }}</span>\n            </button>\n          </div>\n        </div>\n\n        <button class=\"menu-button\" type=\"button\" :aria-label=\"menuOpen ? 'Close menu' : 'Open menu'\" :aria-expanded=\"menuOpen\" @click=\"menuOpen = !menuOpen\">\n          <X v-if=\"menuOpen\" :size=\"23\" />\n          <Menu v-else :size=\"23\" />\n        </button>\n      </div>\n    </div>\n\n    <Transition name=\"drawer\">\n      <div v-if=\"menuOpen\" class=\"mobile-nav\">\n        <div class=\"shell mobile-nav-inner\">\n          <button v-for=\"item in navItems\" :key=\"item.key\" type=\"button\" @click=\"goMain(item)\">\n            {{ localeText(item.label, locale) }}\n          </button>\n          <NuxtLink\n            v-for=\"child in routeChildren\"\n            :key=\"child.key\"\n            class=\"mobile-sub-link\"\n            :to=\"localePath(child.path)\"\n          >\n            {{ localeText(child.label, locale) }}\n          </NuxtLink>\n        </div>\n      </div>\n    </Transition>\n  </header>\n</template>\n","<script setup lang=\"ts\">\nimport { ChevronDown, Globe2, Menu, Search, X } from 'lucide-vue-next'\nimport { getNavByPath, localeText, navItems, searchIndex } from '~/data/site'\n\nconst { locale, setLocale, t } = useI18n()\nconst localePath = useLocalePath()\nconst route = useRoute()\n\nconst menuOpen = ref(false)\nconst languageOpen = ref(false)\nconst searchOpen = ref(false)\nconst searchQuery = ref('')\nconst hoveredNavKey = ref<string | null>(null)\n\nconst activeState = computed(() => getNavByPath(route.path))\nconst currentNav = computed(() => navItems.find((item) => item.key === hoveredNavKey.value) ?? null)\nconst showSubNav = computed(() => !!currentNav.value?.children?.length && currentNav.value.key !== 'home')\nconst subNavChildren = computed(() => currentNav.value?.children ?? [])\nconst routeChildren = computed(() => activeState.value.activeNav.children ?? [])\nconst localizedSearchIndex = computed(() => searchIndex.map((item) => ({\n  ...item,\n  localizedLabel: localeText(item.label, locale.value),\n  localizedDescription: localeText(item.description, locale.value)\n})))\nconst searchResults = computed(() => {\n  const query = searchQuery.value.trim().toLowerCase()\n  if (!query) return localizedSearchIndex.value.slice(0, 6)\n  return localizedSearchIndex.value\n    .filter((item) => `${item.localizedLabel} ${item.localizedDescription}`.toLowerCase().includes(query))\n    .slice(0, 6)\n})\n\nfunction closeFloating() {\n  menuOpen.value = false\n  languageOpen.value = false\n  searchOpen.value = false\n  hoveredNavKey.value = null\n}\n\nfunction openSubNav(key: string) {\n  hoveredNavKey.value = key\n}\n\nfunction clearSubNav() {\n  hoveredNavKey.value = null\n}\n\nfunction goMain(item: typeof navItems[number]) {\n  closeFloating()\n  return navigateTo(localePath(item.key === 'home' ? '/' : item.path))\n}\n\nfunction goSearch(path: string) {\n  searchQuery.value = ''\n  closeFloating()\n  return navigateTo(localePath(path))\n}\n\nasync function changeLanguage(nextLocale: 'zh' | 'en') {\n  localStorage.setItem('site-locale', nextLocale)\n  languageOpen.value = false\n  await setLocale(nextLocale)\n}\n\nwatch(() => route.fullPath, () => closeFloating())\n\nonMounted(async () => {\n  const stored = localStorage.getItem('site-locale')\n  if ((stored === 'zh' || stored === 'en') && stored !== locale.value) {\n    await setLocale(stored)\n  }\n})\n</script>\n\n<template>\n  <a class=\"skip-link\" href=\"#main\">{{ locale === 'en' ? 'Skip to content' : '跳到正文' }}</a>\n  <header class=\"site-header\" @mouseleave=\"clearSubNav\">\n    <div class=\"shell header-inner\">\n      <NuxtLink class=\"brand\" :to=\"localePath('/')\" :aria-label=\"t('siteName')\">\n        <img class=\"brand-logo\" src=\"/assets/company-logo-wide.png\" :alt=\"t('siteName')\" />\n      </NuxtLink>\n\n      <nav class=\"desktop-nav\" :aria-label=\"locale === 'en' ? 'Primary navigation' : '主导航'\">\n        <div\n          v-for=\"item in navItems\"\n          :key=\"item.key\"\n          class=\"nav-item-group\"\n          @mouseenter=\"openSubNav(item.key)\"\n        >\n          <button\n            type=\"button\"\n            class=\"nav-link\"\n            :class=\"{ active: activeState.activeNav.key === item.key }\"\n            :aria-expanded=\"showSubNav && currentNav?.key === item.key ? 'true' : 'false'\"\n            @focus=\"openSubNav(item.key)\"\n            @click=\"goMain(item)\"\n          >\n            {{ localeText(item.label, locale) }}\n          </button>\n\n          <Transition name=\"subnav\">\n            <div v-if=\"showSubNav && currentNav?.key === item.key\" class=\"subnav\">\n              <NuxtLink\n                v-for=\"child in subNavChildren\"\n                :key=\"child.key\"\n                class=\"subnav-pill\"\n                :class=\"{ active: activeState.activeChild?.key === child.key }\"\n                :to=\"localePath(child.path)\"\n                @click=\"clearSubNav\"\n              >\n                {{ localeText(child.label, locale) }}\n              </NuxtLink>\n            </div>\n          </Transition>\n        </div>\n      </nav>\n\n      <div class=\"header-actions\">\n        <div class=\"language-menu\">\n          <button class=\"icon-text-button\" type=\"button\" :aria-expanded=\"languageOpen\" @click=\"languageOpen = !languageOpen\">\n            <Globe2 :size=\"17\" />\n            <span>{{ locale === 'zh' ? '中 / EN' : 'EN / 中' }}</span>\n            <ChevronDown :size=\"15\" />\n          </button>\n          <div v-if=\"languageOpen\" class=\"popover language-popover\">\n            <button type=\"button\" @click=\"changeLanguage('zh')\">中文简体</button>\n            <button type=\"button\" @click=\"changeLanguage('en')\">English</button>\n          </div>\n        </div>\n\n        <div class=\"search-box\" :class=\"{ expanded: searchOpen }\">\n          <button class=\"icon-button\" type=\"button\" :aria-label=\"t('cta.search')\" @click=\"searchOpen = !searchOpen\">\n            <Search :size=\"18\" />\n          </button>\n          <input\n            v-if=\"searchOpen\"\n            v-model=\"searchQuery\"\n            :placeholder=\"locale === 'en' ? 'Search site' : '站内搜索'\"\n            type=\"search\"\n            @keydown.esc=\"searchOpen = false\"\n          />\n          <div v-if=\"searchOpen\" class=\"popover search-popover\">\n            <button v-for=\"result in searchResults\" :key=\"result.path\" type=\"button\" @click=\"goSearch(result.path)\">\n              <strong>{{ result.localizedLabel }}</strong>\n              <span>{{ result.localizedDescription }}</span>\n            </button>\n          </div>\n        </div>\n\n        <button class=\"menu-button\" type=\"button\" :aria-label=\"menuOpen ? 'Close menu' : 'Open menu'\" :aria-expanded=\"menuOpen\" @click=\"menuOpen = !menuOpen\">\n          <X v-if=\"menuOpen\" :size=\"23\" />\n          <Menu v-else :size=\"23\" />\n        </button>\n      </div>\n    </div>\n\n    <Transition name=\"drawer\">\n      <div v-if=\"menuOpen\" class=\"mobile-nav\">\n        <div class=\"shell mobile-nav-inner\">\n          <button v-for=\"item in navItems\" :key=\"item.key\" type=\"button\" @click=\"goMain(item)\">\n            {{ localeText(item.label, locale) }}\n          </button>\n          <NuxtLink\n            v-for=\"child in routeChildren\"\n            :key=\"child.key\"\n            class=\"mobile-sub-link\"\n            :to=\"localePath(child.path)\"\n          >\n            {{ localeText(child.label, locale) }}\n          </NuxtLink>\n        </div>\n      </div>\n    </Transition>\n  </header>\n</template>\n","<script setup lang=\"ts\">\nimport { ArrowUpRight, Linkedin, MessageSquareText } from 'lucide-vue-next'\nimport { localeText, navItems } from '~/data/site'\n\nconst { locale, t } = useI18n()\nconst localePath = useLocalePath()\n</script>\n\n<template>\n  <footer class=\"site-footer\">\n    <div class=\"shell footer-grid\">\n      <div class=\"footer-brand\">\n        <NuxtLink class=\"brand brand-light\" :to=\"localePath('/')\">\n          <img class=\"brand-logo\" src=\"/assets/company-logo-wide.png\" :alt=\"t('siteName')\" />\n        </NuxtLink>\n        <p>{{ t('footer.summary') }}</p>\n        <NuxtLink class=\"text-link text-link-light\" :to=\"localePath('/contact/inquiry')\">\n          {{ t('cta.contact') }} <ArrowUpRight :size=\"16\" />\n        </NuxtLink>\n      </div>\n\n      <div class=\"footer-links-group\" v-for=\"item in navItems.slice(1)\" :key=\"item.key\">\n        <h3>{{ localeText(item.label, locale) }}</h3>\n        <nav class=\"footer-links\">\n          <NuxtLink v-for=\"child in item.children\" :key=\"child.key\" :to=\"localePath(child.path)\">\n            {{ localeText(child.label, locale) }}\n          </NuxtLink>\n        </nav>\n      </div>\n\n      <div class=\"footer-follow\">\n        <h3>{{ t('footer.follow') }}</h3>\n        <div class=\"qr-box\">\n          <MessageSquareText :size=\"24\" />\n          <span>{{ locale === 'en' ? 'WeChat official account' : '微信公众号二维码' }}</span>\n        </div>\n        <a href=\"#\" aria-label=\"LinkedIn\"><Linkedin :size=\"17\" /> LinkedIn</a>\n      </div>\n    </div>\n    <div class=\"shell footer-bottom\">\n      <span>© 2025 {{ t('siteName') }} {{ t('footer.rights') }} | 